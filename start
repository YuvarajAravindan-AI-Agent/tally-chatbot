#!/usr/bin/env bash
# Improved startup wrapper for tally-chatbot
# This script is more robust and handles common errors
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
NGROK_DOMAIN="headset-slighting-heave.ngrok-free.dev"
PROXY_LOG="/tmp/tally-proxy.log"
TUNNEL_LOG="/tmp/tally-ngrok.log"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo -e "${GREEN}=== Tally Chatbot Startup ===${NC}\n"

# Check prerequisites
echo "Checking prerequisites..."

# 1. Check if TallyPrime is accessible on port 9000; launch it via Bottles if not
if ! timeout 2 bash -c "</dev/tcp/127.0.0.1/9000" 2>/dev/null; then
  echo -e "${YELLOW}⚠ TallyPrime not accessible on port 9000 — launching via Bottles...${NC}"
  setsid flatpak run --command=bottles-cli com.usebottles.bottles run -b Tally -p tally \
    >/tmp/tally-launch.log 2>&1 < /dev/null &
  echo "  Waiting for TallyPrime to boot and open its gateway on :9000 (can take ~30-60s)..."
  READY=0
  for _ in $(seq 1 90); do
    if timeout 1 bash -c "</dev/tcp/127.0.0.1/9000" 2>/dev/null; then
      READY=1
      break
    fi
    sleep 1
  done
  if [ "$READY" = "1" ]; then
    echo -e "${GREEN}✓ TallyPrime is up on :9000${NC}"
  else
    echo -e "${RED}✗ TallyPrime didn't come up on :9000 within 90s.${NC}"
    echo "  Check if it launched (a window should be visible) — first-time or slow boots can take longer."
    echo "  Log: /tmp/tally-launch.log"
    read -p "  Press Enter once TallyPrime is open and ready, or Ctrl+C to cancel: "
  fi
fi

# 2. Check if proxy venv exists
if [ ! -d "$SCRIPT_DIR/proxy/.venv" ]; then
  echo -e "${RED}✗ Error: Python venv not found at proxy/.venv${NC}"
  echo "  Run this in the proxy directory:"
  echo "  python3 -m venv .venv && .venv/bin/pip install uvicorn fastapi"
  exit 1
fi

# 3. Check if ngrok is installed
if [ ! -f "$HOME/bin/ngrok" ]; then
  echo -e "${RED}✗ Error: ngrok not found at ~/bin/ngrok${NC}"
  echo "  Download from: https://ngrok.com/download"
  exit 1
fi

echo -e "${GREEN}✓ Prerequisites OK${NC}\n"

# Start proxy
echo "Starting proxy server on port 8787..."
if ss -tln 2>/dev/null | grep -q ':8787'; then
  echo -e "${GREEN}✓ Proxy already running on :8787${NC}"
else
  setsid "$SCRIPT_DIR/proxy/.venv/bin/uvicorn" --app-dir "$SCRIPT_DIR/proxy" main:app \
    --host 127.0.0.1 --port 8787 >"$PROXY_LOG" 2>&1 < /dev/null &
  sleep 2

  if ss -tln 2>/dev/null | grep -q ':8787'; then
    echo -e "${GREEN}✓ Proxy started (log: $PROXY_LOG)${NC}"
  else
    echo -e "${RED}✗ Proxy failed to start. Check $PROXY_LOG:${NC}"
    cat "$PROXY_LOG"
    exit 1
  fi
fi

# Start ngrok tunnel
echo "Starting ngrok tunnel on $NGROK_DOMAIN..."

# Kill any existing ngrok processes
for p in $(pgrep -x ngrok 2>/dev/null || true); do
  kill "$p" 2>/dev/null || true
done
sleep 1

# Start new ngrok tunnel
setsid "$HOME/bin/ngrok" http 8787 --url="https://$NGROK_DOMAIN" \
  --log="$TUNNEL_LOG" --log-format=logfmt >/dev/null 2>&1 < /dev/null &
sleep 4

# Check if tunnel started successfully
if grep -q "started tunnel" "$TUNNEL_LOG" 2>/dev/null; then
  echo -e "${GREEN}✓ Tunnel started${NC}\n"
else
  echo -e "${YELLOW}⚠ ngrok tunnel status unclear. Check $TUNNEL_LOG:${NC}"
  tail -5 "$TUNNEL_LOG" || true
fi

# Summary
echo -e "${GREEN}========================================${NC}"
echo -e "${GREEN}✓ Tally Chatbot is ready!${NC}"
echo -e "${GREEN}========================================${NC}\n"

echo "Local Services:"
echo "  Proxy:    http://127.0.0.1:8787 (internal)"
echo "  Tunnel:   https://$NGROK_DOMAIN (public)"
echo ""
echo "Access Chatbot:"
echo "  https://tally-chatbot.vercel.app"
echo ""
echo "Test it:"
echo "  1. Open the chatbot URL"
echo "  2. Enter your passcode"
echo "  3. Ask: 'What is my total receivables?'"
echo ""
echo "Logs:"
echo "  tail -f /tmp/tally-proxy.log   (proxy debug)"
echo "  tail -f /tmp/tally-ngrok.log   (tunnel debug)"
echo ""
echo "Stop services:"
echo "  pkill ngrok                    (stop tunnel)"
echo "  pkill -f uvicorn               (stop proxy)"
echo ""

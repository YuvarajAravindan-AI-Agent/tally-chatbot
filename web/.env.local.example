# Copy to .env.local for local dev (gitignored). In production set these in Vercel.

# Google AI Studio key (server-side only — never exposed to the browser)
GEMINI_API_KEY=your-gemini-key
# Optional model override
GEMINI_MODEL=gemini-flash-latest

# The Cloudflare tunnel URL printed by start-local.sh
TALLY_PROXY_URL=https://xxxx.trycloudflare.com
# Must match proxy/.env TALLY_PROXY_TOKEN
TALLY_PROXY_TOKEN=your-proxy-token

# Passcode you give to your contacts to access the chatbot
ACCESS_PASSCODE=set-a-passcode

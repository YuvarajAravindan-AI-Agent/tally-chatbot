# Copy to .env and fill in. .env is gitignored — never commit real values.

# Shared secret the Vercel app must send as: Authorization: Bearer <token>
TALLY_PROXY_TOKEN=change-me

# Tally gateway (local)
TALLY_URL=http://localhost:9000
TALLY_TIMEOUT=20

# CORS origins allowed to call the proxy directly (comma-separated).
# Leave as * for now; tighten to your Vercel URL later.
ALLOWED_ORIGINS=*
